# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.youragency.com

# Contact form email (https://resend.com) — without it, leads are logged to the server console
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@youragency.com
CONTACT_FROM_EMAIL="Your Agency <hello@youragency.com>"
# Optional: newsletter sign-ups go to this Resend audience
RESEND_AUDIENCE_ID=

# Spam protection (https://developers.cloudflare.com/turnstile) — optional but recommended
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File uploads for "Attach a brief" (Vercel Blob). Without it, files are attached to the lead email.
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=
